import { useState, useEffect, useMemo, useCallback, useRef } from 'react';
import type { Beteiligte, Vorhaben, MassstaebeUndGrenzen, Erkenntnisse, Entscheidungen, Massnahmen, Erfahrungen } from '@/types/app';
import { LivingAppsService } from '@/services/livingAppsService';
import { t } from '@/i18n';

/** Dashboard data + the OPTIMISTIC-WRITE API.
 *
 *  The per-entity setters (`set<Entity>`) are exported for exactly one job:
 *  optimistic updates on drag writes (onEventDrop / onEventResize /
 *  onCardMove). Call the setter FIRST — the bar/card lands instantly — then
 *  fire the PATCH in the background and call `fetchAll()` ONLY in the catch.
 *  Never await the PATCH before updating state (the UI freezes for the full
 *  round-trip on every drag) and never refetch after a successful write.
 *  There is no other mechanism (no `__optimistic`, no `mutate`).
 */
/** Entities this hook can load — the same keys the journey layer uses. */
export type DashboardEntity = 'beteiligte' | 'vorhaben' | 'massstaebe_und_grenzen' | 'erkenntnisse' | 'entscheidungen' | 'massnahmen' | 'erfahrungen';

/** Silent re-read interval from the plan (generated): visitors or tools add records. */
const LIVE_MS = 0;
/** The lists a tick re-reads — ONE request each; the rest waits for an event or the tab's return. */
const LIVE_ENTITIES: string[] = [];
/** Marks a list the tick skipped: its rows and its forbidden state stay as they are. */
const SKIP = Symbol('skip');

export interface DashboardDataOptions {
  /** Entities this page does NOT need (picked through useRecordSearch instead).
   *  Every flow page mounts this hook on its own route, so without `omit` a
   *  page that searches 3.000 guests server-side would still pull all 3.000
   *  through the side door. */
  omit?: DashboardEntity[];
}

export function useDashboardData(options: DashboardDataOptions = {}) {
  // A string key, not the array: an inline `omit={['gaeste']}` is a new array
  // on every render and would restart the fetch forever.
  const omitKey = (options.omit ?? []).slice().sort().join('|');
  const [beteiligte, setBeteiligte] = useState<Beteiligte[]>([]);
  const [vorhaben, setVorhaben] = useState<Vorhaben[]>([]);
  const [massstaebeUndGrenzen, setMassstaebeUndGrenzen] = useState<MassstaebeUndGrenzen[]>([]);
  const [erkenntnisse, setErkenntnisse] = useState<Erkenntnisse[]>([]);
  const [entscheidungen, setEntscheidungen] = useState<Entscheidungen[]>([]);
  const [massnahmen, setMassnahmen] = useState<Massnahmen[]>([]);
  const [erfahrungen, setErfahrungen] = useState<Erfahrungen[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);
  /** Lists the signed-in user may not read (403 on the platform). They load as
   *  empty and the rest of the page loads normally — one forbidden list used to
   *  empty the whole dashboard (05.10.2026). Hide a block whose list is here. */
  const [forbidden, setForbidden] = useState<DashboardEntity[]>([]);

  // Every list on its own: a 403 is „not yours“, any other failure is an error.
  const forbiddenRef = useRef<DashboardEntity[]>([]);
  const settle = useCallback((settled: PromiseSettledResult<unknown>[]) => {
    const denied: DashboardEntity[] = [];
    let failure: unknown = null;
    // null = this list failed for another reason, or the tick skipped it: its current data stays
    const pick = <T,>(i: number, key: DashboardEntity): T[] | null => {
      const s = settled[i];
      if (s.status === 'fulfilled') return s.value as T[];
      if (s.reason === SKIP) { if (forbiddenRef.current.includes(key)) denied.push(key); return null; }
      if ((s.reason as { status?: number } | null)?.status === 403) { denied.push(key); return []; }
      failure = failure ?? s.reason;
      return null;
    };
    { const rows = pick<Beteiligte>(0, 'beteiligte'); if (rows) setBeteiligte(rows); }
    { const rows = pick<Vorhaben>(1, 'vorhaben'); if (rows) setVorhaben(rows); }
    { const rows = pick<MassstaebeUndGrenzen>(2, 'massstaebe_und_grenzen'); if (rows) setMassstaebeUndGrenzen(rows); }
    { const rows = pick<Erkenntnisse>(3, 'erkenntnisse'); if (rows) setErkenntnisse(rows); }
    { const rows = pick<Entscheidungen>(4, 'entscheidungen'); if (rows) setEntscheidungen(rows); }
    { const rows = pick<Massnahmen>(5, 'massnahmen'); if (rows) setMassnahmen(rows); }
    { const rows = pick<Erfahrungen>(6, 'erfahrungen'); if (rows) setErfahrungen(rows); }
    forbiddenRef.current = denied;
    setForbidden(prev => (prev.join('|') === denied.join('|') ? prev : denied));
    return failure;
  }, []);

  const fetchAll = useCallback(async () => {
    setError(null);
    const omit = new Set(omitKey ? omitKey.split('|') : []);
    try {
      const failure = settle(await Promise.allSettled([
        omit.has('beteiligte') ? Promise.resolve([] as Beteiligte[]) : LivingAppsService.getBeteiligte(),
        omit.has('vorhaben') ? Promise.resolve([] as Vorhaben[]) : LivingAppsService.getVorhaben(),
        omit.has('massstaebe_und_grenzen') ? Promise.resolve([] as MassstaebeUndGrenzen[]) : LivingAppsService.getMassstaebeUndGrenzen(),
        omit.has('erkenntnisse') ? Promise.resolve([] as Erkenntnisse[]) : LivingAppsService.getErkenntnisse(),
        omit.has('entscheidungen') ? Promise.resolve([] as Entscheidungen[]) : LivingAppsService.getEntscheidungen(),
        omit.has('massnahmen') ? Promise.resolve([] as Massnahmen[]) : LivingAppsService.getMassnahmen(),
        omit.has('erfahrungen') ? Promise.resolve([] as Erfahrungen[]) : LivingAppsService.getErfahrungen(),
      ]));
      if (failure) throw failure;
    } catch (err) {
      setError(err instanceof Error ? err : new Error(t('data_load_failed')));
    } finally {
      setLoading(false);
    }
  }, [omitKey, settle]);

  useEffect(() => { fetchAll(); }, [fetchAll]);

  // Silent background refresh (no loading state change → no flicker)
  useEffect(() => {
    const omit = new Set(omitKey ? omitKey.split('|') : []);
    async function silentRefresh() {
      try {
        // a failed list keeps its stale data out of the way: settle() only
        // replaces what loaded or was refused
        settle(await Promise.allSettled([
          omit.has('beteiligte') ? Promise.resolve([] as Beteiligte[]) : LivingAppsService.getBeteiligte(),
          omit.has('vorhaben') ? Promise.resolve([] as Vorhaben[]) : LivingAppsService.getVorhaben(),
          omit.has('massstaebe_und_grenzen') ? Promise.resolve([] as MassstaebeUndGrenzen[]) : LivingAppsService.getMassstaebeUndGrenzen(),
          omit.has('erkenntnisse') ? Promise.resolve([] as Erkenntnisse[]) : LivingAppsService.getErkenntnisse(),
          omit.has('entscheidungen') ? Promise.resolve([] as Entscheidungen[]) : LivingAppsService.getEntscheidungen(),
          omit.has('massnahmen') ? Promise.resolve([] as Massnahmen[]) : LivingAppsService.getMassnahmen(),
          omit.has('erfahrungen') ? Promise.resolve([] as Erfahrungen[]) : LivingAppsService.getErfahrungen(),
        ]));
      } catch {
        // silently ignore — stale data is better than no data
      }
    }
    function handleRefresh() { void silentRefresh(); }
    // assistant:data-changed comes from the assistant (<la-klar-assistant>)
    // after every mutation. The element additionally fires the legacy
    // dashboard-refresh event for OLD deployed bundles — do NOT subscribe to
    // both here, or every mutation fetches twice.
    window.addEventListener('assistant:data-changed', handleRefresh);
    // Records that arrive without the team (a visitor on a public page, a
    // tool) show up by themselves: a silent re-read every LIVE_MS while the
    // tab is visible, once on return (S-1/W-19, acceptance 4 — the moderation
    // saw new contributions only after a reload). 0 = events only.
    // the tick: only LIVE_ENTITIES, one request each
    const only = new Set(LIVE_ENTITIES);
    async function tick() {
      try {
        settle(await Promise.allSettled([
          !only.has('beteiligte') ? Promise.reject(SKIP) : omit.has('beteiligte') ? Promise.resolve([] as Beteiligte[]) : LivingAppsService.getBeteiligte(),
          !only.has('vorhaben') ? Promise.reject(SKIP) : omit.has('vorhaben') ? Promise.resolve([] as Vorhaben[]) : LivingAppsService.getVorhaben(),
          !only.has('massstaebe_und_grenzen') ? Promise.reject(SKIP) : omit.has('massstaebe_und_grenzen') ? Promise.resolve([] as MassstaebeUndGrenzen[]) : LivingAppsService.getMassstaebeUndGrenzen(),
          !only.has('erkenntnisse') ? Promise.reject(SKIP) : omit.has('erkenntnisse') ? Promise.resolve([] as Erkenntnisse[]) : LivingAppsService.getErkenntnisse(),
          !only.has('entscheidungen') ? Promise.reject(SKIP) : omit.has('entscheidungen') ? Promise.resolve([] as Entscheidungen[]) : LivingAppsService.getEntscheidungen(),
          !only.has('massnahmen') ? Promise.reject(SKIP) : omit.has('massnahmen') ? Promise.resolve([] as Massnahmen[]) : LivingAppsService.getMassnahmen(),
          !only.has('erfahrungen') ? Promise.reject(SKIP) : omit.has('erfahrungen') ? Promise.resolve([] as Erfahrungen[]) : LivingAppsService.getErfahrungen(),
        ]));
      } catch {
        // silently ignore — stale data is better than no data
      }
    }
    const timer = LIVE_MS > 0 && only.size > 0 ? window.setInterval(() => { if (!document.hidden) void tick(); }, LIVE_MS) : null;
    const onVisible = () => { if (!document.hidden && LIVE_MS > 0) void silentRefresh(); };
    document.addEventListener('visibilitychange', onVisible);
    return () => {
      window.removeEventListener('assistant:data-changed', handleRefresh);
      if (timer !== null) window.clearInterval(timer);
      document.removeEventListener('visibilitychange', onVisible);
    };
  }, [omitKey, settle]);

  const beteiligteMap = useMemo(() => {
    const m = new Map<string, Beteiligte>();
    beteiligte.forEach(r => m.set(r.record_id, r));
    return m;
  }, [beteiligte]);

  const vorhabenMap = useMemo(() => {
    const m = new Map<string, Vorhaben>();
    vorhaben.forEach(r => m.set(r.record_id, r));
    return m;
  }, [vorhaben]);

  return { beteiligte, setBeteiligte, vorhaben, setVorhaben, massstaebeUndGrenzen, setMassstaebeUndGrenzen, erkenntnisse, setErkenntnisse, entscheidungen, setEntscheidungen, massnahmen, setMassnahmen, erfahrungen, setErfahrungen, loading, error, fetchAll, forbidden, beteiligteMap, vorhabenMap };
}

/** The hook's return — the `data` prop of DashboardOverview in the Ready-Wrapper form. */
export type DashboardData = ReturnType<typeof useDashboardData>;
